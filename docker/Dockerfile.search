# Qubit Search Engine (Algolia 代替の全文検索サーバー)
# 標準ライブラリのみで動くため torch などは不要です。
#
#   docker build -f docker/Dockerfile.search -t qubit-search .
#   docker run -p 8080:8080 -v qubit-search-data:/data \
#     -e QUBIT_SEARCH_ADMIN_KEY=... -e QUBIT_SEARCH_API_KEY=... qubit-search
FROM python:3.11-slim

WORKDIR /app
COPY neuroquantum_search.py qubit_search_engine.py ./

ENV PYTHONUNBUFFERED=1 \
    QUBIT_SEARCH_DATA_DIR=/data \
    PORT=8080
VOLUME ["/data"]
EXPOSE 8080

CMD ["python", "qubit_search_engine.py", "serve"]
